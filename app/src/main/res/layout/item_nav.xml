<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_item_height"
    android:background="@drawable/bg_rail_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="12dp">

    <View
        android:id="@+id/navIndicator"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <ImageView
        android:id="@+id/navIcon"
        android:layout_width="@dimen/nav_icon"
        android:layout_height="@dimen/nav_icon"
        android:layout_marginStart="32dp"
        android:contentDescription="@string/app_name"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/navLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="@color/flyme_label_level1"
        android:textSize="26sp" />
</LinearLayout>
