<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/flyme_modal_background"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        style="@style/Text.EX2.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voice_available_commands" />

    <TextView
        style="@style/Text.EX2.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voice_available_commands_note" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="430dp"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/voiceCommandsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </ScrollView>

    <TextView
        android:id="@+id/voiceCommandsClose"
        style="@style/Widget.EX2.FlymeButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:text="@string/voice_available_commands_close" />
</LinearLayout>
