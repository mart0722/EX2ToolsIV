<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/widget_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/widget_bg_layer"
        android:background="@drawable/widget_card_bg_100"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text=""/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:gravity="center"
            android:id="@+id/btn_fan_plus"
            android:background="@drawable/btn_circle"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:text="+"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ic_widget_fan"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/cx_text_primary"
                android:id="@+id/tv_fan_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="вЂ”"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp">
                <TextView
                    android:id="@+id/dot_fan_1"
                    android:background="@drawable/widget_dot_off"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:text=""
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:id="@+id/dot_fan_2"
                    android:background="@drawable/widget_dot_off"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:text=""
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:id="@+id/dot_fan_3"
                    android:background="@drawable/widget_dot_off"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:text=""
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:id="@+id/dot_fan_4"
                    android:background="@drawable/widget_dot_off"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:text=""
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:id="@+id/dot_fan_5"
                    android:background="@drawable/widget_dot_off"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:text=""
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:id="@+id/dot_fan_6"
                    android:background="@drawable/widget_dot_off"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:text=""
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:id="@+id/dot_fan_7"
                    android:background="@drawable/widget_dot_off"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:text=""/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cx_text_secondary"
                android:id="@+id/tv_fan_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Р’РµРЅС‚РёР»СЏС‚РѕСЂ"/>
        </LinearLayout>
        <TextView
            android:textSize="31sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:gravity="center"
            android:id="@+id/btn_fan_minus"
            android:background="@drawable/btn_circle"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:text="вЂ“"/>
    </LinearLayout>
</FrameLayout>
