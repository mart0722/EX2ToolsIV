<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="@dimen/content_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/screen_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sounds_section_lock" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EX2.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <com.ex2tools.iv.ui.FlymeSwitchRow
                        android:id="@+id/soundActivate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sounds_activate"
                        android:textColor="@color/flyme_label_level1"
                        android:textSize="22sp"
                        app:rowDescription="@string/sounds_activate_note" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/sounds_section_lock"
                            android:src="@drawable/ic_widget_volume"
                            android:tint="@color/flyme_blue" />

                        <TextView
                            android:id="@+id/soundStatus"
                            style="@style/Text.EX2.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/sounds_status_factory" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/sounds_my" />

            <TextView
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sounds_my_note" />

            <LinearLayout
                android:id="@+id/soundsBuiltInList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/sounds_factory" />

            <TextView
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sounds_factory_note" />

            <LinearLayout
                android:id="@+id/soundsFactoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/sounds_custom" />

            <TextView
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sounds_custom_note" />

            <LinearLayout
                android:id="@+id/soundsCustomList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/soundsCustomEmpty"
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sounds_empty_custom" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/soundsAdd"
                style="@style/Widget.EX2.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:text="@string/sounds_add_wav"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/soundsRestore"
                style="@style/Widget.EX2.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:text="@string/sounds_restore_factory"
                android:textSize="20sp" />

            <TextView
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sounds_info" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
