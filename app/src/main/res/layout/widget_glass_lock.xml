<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wg_card_100" />

    <TextView
        android:id="@+id/widget_button_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp" />

    <LinearLayout
        android:id="@+id/lock_body"
        style="@style/WgChip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@null">

        <ImageView
            android:id="@+id/img_lock"
            style="@style/WgClimateIcon"
            android:contentDescription="@string/wg_lock_label"
            android:src="@drawable/wg_ic_lock" />
    </LinearLayout>
</FrameLayout>
