<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/flyme_modal_background"
    android:orientation="vertical"
    android:padding="30dp">

    <TextView
        android:id="@+id/progressTitle"
        style="@style/Text.EX2.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rvc_black_applying" />

    <TextView
        android:id="@+id/progressMessage"
        style="@style/Text.EX2.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/rvc_black_confirm_message" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/flyme_blue"
        android:progressTint="@color/flyme_blue" />
</LinearLayout>
