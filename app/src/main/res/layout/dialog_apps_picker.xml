<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/flyme_modal_background"
    android:orientation="vertical"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.EX2.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widgets_apps_title" />

            <TextView
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widgets_apps_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/appsPickerCounter"
            style="@style/Text.EX2.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/appsPickerSearch"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_panel"
        android:hint="@string/apps_search_hint"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/flyme_label_level1"
        android:textColorHint="@color/flyme_label_level3"
        android:textSize="19sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsPickerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/appsPickerEmpty"
            style="@style/Text.EX2.Caption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widgets_apps_empty"
            android:visibility="gone" />

        <TextView
            android:id="@+id/appsPickerLoading"
            style="@style/Text.EX2.Caption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widgets_apps_loading" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/appsPickerCancel"
            style="@style/Widget.EX2.FlymeButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/confirm_cancel" />

        <TextView
            android:id="@+id/appsPickerSave"
            style="@style/Widget.EX2.FlymeButton.Primary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/widgets_apps_save" />
    </LinearLayout>
</LinearLayout>
