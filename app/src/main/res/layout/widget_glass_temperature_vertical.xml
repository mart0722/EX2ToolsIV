<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wg_card_100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/btn_temp_plus"
            style="@style/WgClimateRoundButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="+" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_temp_title"
                style="@style/WgClimateIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/wg_ic_temp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_temp_value"
                    style="@style/WgValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />

                <TextView
                    android:id="@+id/tv_temp_unit"
                    style="@style/WgUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="2dp"
                    android:text="°C" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/temp_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="15"
                android:progress="7"
                android:progressDrawable="@drawable/wg_progress" />

            <TextView
                android:id="@+id/widget_title"
                style="@style/WgSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ТЕМПЕРАТУРА" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_temp_minus"
            style="@style/WgClimateRoundButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="−" />
    </LinearLayout>
</FrameLayout>
