<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:background="@drawable/flyme_modal_background"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/permTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/perm_title"
        android:textColor="@color/flyme_label_level1"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/permSubtitle"
        style="@style/Text.EX2.ListSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/perm_description" />

    <ScrollView
        android:id="@+id/permScroll"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="20dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/permList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/permEmpty"
        style="@style/Text.EX2.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/perm_empty"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/permGrantAll"
            style="@style/Widget.EX2.FlymeButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/perm_grant_all"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/permClose"
            style="@style/Widget.EX2.FlymeButton.Primary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/perm_close"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
