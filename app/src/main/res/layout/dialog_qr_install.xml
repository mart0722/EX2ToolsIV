<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:background="@drawable/flyme_modal_background"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        style="@style/Text.EX2.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apps_qr_title" />

    <TextView
        style="@style/Text.EX2.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/apps_qr_subtitle" />

    <FrameLayout
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_qr_panel"
        android:padding="16dp">

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/apps_qr_title"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/qrUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/cyan"
        android:textSize="21sp" />

    <ProgressBar
        android:id="@+id/qrProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/cyan"
        android:max="100"
        android:progressTint="@color/cyan"
        android:visibility="gone" />

    <TextView
        android:id="@+id/qrStatus"
        style="@style/Text.EX2.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/apps_qr_starting"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/qrCancel"
        style="@style/Widget.EX2.FlymeButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="end"
        android:layout_marginTop="18dp"
        android:minWidth="130dp"
        android:text="@string/apps_qr_cancel" />
</LinearLayout>
