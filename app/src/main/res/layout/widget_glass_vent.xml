<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/widget_glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/wg_glass_inset"
        android:paddingTop="@dimen/wg_glass_compact_inset"
        android:paddingEnd="@dimen/wg_glass_inset"
        android:paddingBottom="@dimen/wg_glass_compact_inset">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_vent_header"
                style="@style/WgSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:minHeight="15dp"
                android:text="@string/wg_vent_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include layout="@layout/widget_vent_directions" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_vent_fan_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/wg_glass_control_gap"
            android:layout_weight="1">

            <include
                layout="@layout/widget_vent_fan_controls"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
