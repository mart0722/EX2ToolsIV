<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_windshield_heat"
    style="@style/WgChip"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/img_windshield_heat"
        style="@style/WgClimateIcon"
        android:src="@drawable/wg_ic_windshield_heat_light" />

    <TextView
        android:id="@+id/txt_windshield_heat"
        style="@style/WgClimateChipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_name_windshield_heat" />
</LinearLayout>
