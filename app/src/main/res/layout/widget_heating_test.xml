<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wg_card_100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wg_ic_heat"
                android:tint="@color/wg_text" />

            <TextView
                android:id="@+id/txt_heat_header"
                style="@style/WgTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Обогревы" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chip_wheel_heat"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_wheel_heat"
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_wheel_heat_light" />

                <TextView
                    android:id="@+id/txt_wheel_heat"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Руль" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_front_rear_defrost"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_front_rear_defrost"
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_rear_heat_light" />

                <TextView
                    android:id="@+id/txt_front_rear_defrost"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Заднее" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_front_max_defrost"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_heat_windshield"
                    android:tint="@color/wg_text" />

                <TextView
                    android:id="@+id/txt_front_max_defrost"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Макс." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chip_windshield_heat"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_windshield_heat"
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_windshield_heat_light" />

                <TextView
                    android:id="@+id/txt_windshield_heat"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Лобовое" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_seat_heat_driver"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_seat"
                    android:tint="@color/wg_text" />

                <TextView
                    android:id="@+id/txt_seat_heat_driver"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Лев. 0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_seat_heat_passenger"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_seat"
                    android:tint="@color/wg_text" />

                <TextView
                    android:id="@+id/txt_seat_heat_passenger"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Прав. 0" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
