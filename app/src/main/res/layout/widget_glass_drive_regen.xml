<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wg_card_100" />

    <LinearLayout
        android:id="@+id/widget_glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/wg_glass_inset">

        <TextView
            android:id="@+id/txt_drive_header"
            style="@style/WgSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="РЕЖИМ ЕЗДЫ" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chip_drive_eco"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_drive_eco"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_drive_eco" />

                <TextView
                    android:id="@+id/txt_drive_eco"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Эко" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_drive_comfort"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_drive_comfort"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_drive_comfort" />

                <TextView
                    android:id="@+id/txt_drive_comfort"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Комфорт" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_drive_sport"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_drive_sport"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_drive_sport" />

                <TextView
                    android:id="@+id/txt_drive_sport"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Спорт" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txt_regen_header"
            style="@style/WgSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="РЕКУПЕРАЦИЯ" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chip_regen_low"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_regen_low"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_regen_low" />

                <TextView
                    android:id="@+id/txt_regen_low"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Слабая" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_regen_mid"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_regen_mid"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_regen_mid" />

                <TextView
                    android:id="@+id/txt_regen_mid"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Средняя" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_regen_high"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_regen_high"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_regen_high" />

                <TextView
                    android:id="@+id/txt_regen_high"
                    style="@style/WgChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сильная" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
