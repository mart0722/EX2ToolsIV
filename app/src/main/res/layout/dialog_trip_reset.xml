<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:background="@drawable/flyme_modal_background"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        style="@style/Text.EX2.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_trip_reset_title" />

    <TextView
        android:id="@+id/tripResetMessage"
        style="@style/Text.EX2.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/status_trip_reset_question" />

    <TextView
        android:id="@+id/tripResetCurrent"
        style="@style/Text.EX2.NumberSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/overview_no_data"
        android:textColor="@color/flyme_blue" />

    <TextView
        android:id="@+id/tripResetOdometer"
        style="@style/Text.EX2.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_dim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tripResetCancel"
            style="@style/Widget.EX2.FlymeButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/tripResetConfirm"
            style="@style/Widget.EX2.FlymeButton.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/status_trip_reset_confirm" />
    </LinearLayout>
</LinearLayout>
