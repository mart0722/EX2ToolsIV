<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/flyme_modal_background"
    android:orientation="vertical"
    android:padding="36dp">

    <TextView
        android:id="@+id/confirmTitle"
        style="@style/Text.EX2.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center" />

    <TextView
        android:id="@+id/confirmMessage"
        style="@style/Text.EX2.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/flyme_label_level2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/confirmCancel"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:background="@drawable/flyme_button_background"
            android:gravity="center">

            <TextView
                android:id="@+id/confirmCancelText"
                style="@style/Text.EX2.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm_cancel" />
        </LinearLayout>

        <Space
            android:id="@+id/confirmSpace"
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/confirmOk"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:background="@drawable/flyme_scan_button_background"
            android:gravity="center">

            <TextView
                android:id="@+id/confirmOkText"
                style="@style/Text.EX2.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm_yes"
                android:textColor="@color/flyme_white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
