<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/widget_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/widget_bg_layer"
        android:background="@drawable/widget_card_bg_100"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text=""/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:gravity="center"
            android:id="@+id/btn_temp_minus"
            android:background="@drawable/btn_circle"
            android:layout_width="67dp"
            android:layout_height="67dp"
            android:text="−"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/temp_mid_col"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/temp_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ic_widget_thermometer"
                android:tint="@color/cx_text_primary" />
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/cx_text_primary"
                    android:id="@+id/tv_temp_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/cx_text_secondary"
                    android:id="@+id/tv_temp_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="°C"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/cx_text_secondary"
                android:id="@+id/tv_temp_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Температура"/>
        </LinearLayout>
        <TextView
            android:textSize="31sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:gravity="center"
            android:id="@+id/btn_temp_plus"
            android:background="@drawable/btn_circle"
            android:layout_width="67dp"
            android:layout_height="67dp"
            android:text="+"/>
    </LinearLayout>
</FrameLayout>
