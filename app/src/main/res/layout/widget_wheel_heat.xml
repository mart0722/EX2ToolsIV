<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_wheel_heat"
    style="@style/WgGlassChip"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/img_wheel_heat"
        style="@style/WgClimateIcon"
        android:src="@drawable/wg_ic_wheel_heat_light" />

    <TextView
        android:id="@+id/txt_wheel_heat"
        style="@style/WgClimateChipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_name_wheel_heat" />
</LinearLayout>
