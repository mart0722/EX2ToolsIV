<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/voice_overlay_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/voiceOverlayTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/voice_listening"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp" />

    <com.ex2tools.iv.voice.VoiceWaveView
        android:id="@+id/voiceOverlayWave"
        android:layout_width="180dp"
        android:layout_height="56dp"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/voiceOverlayText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:text="@string/voice_command_hint"
        android:textColor="#B3FFFFFF"
        android:textSize="18sp" />
</LinearLayout>
