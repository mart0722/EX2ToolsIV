<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="@dimen/content_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/screen_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_section_icons" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/switchWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/wifi_icon"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/status_wifi_note" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/switchBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/battery_icon"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/status_battery_note" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/switchStatusTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/status_temp_icon"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/status_temp_note" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/switchTotalKm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/status_total_icon"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/status_total_note" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/switchTripKm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/status_trip_icon"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/status_trip_note" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/switchBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/status_brightness_icon"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/status_brightness_note" />

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/status_section_interval" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/intervalLabel"
                    style="@style/Text.EX2.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_interval" />

                <SeekBar
                    android:id="@+id/intervalSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="27"
                    android:progress="2" />
            </LinearLayout>

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/status_section_brightness" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/brightnessLabel"
                    style="@style/Text.EX2.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_brightness_level" />

                <SeekBar
                    android:id="@+id/brightnessSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="95"
                    android:progress="45" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
