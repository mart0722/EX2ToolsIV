<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/widget_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/widget_bg_layer"
        android:background="@drawable/widget_card_bg_100"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text=""/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:gravity="center"
            android:id="@+id/btn_vent_next"
            android:background="@drawable/btn_circle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/img_vent_mode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ic_widget_vent_face"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/cx_text_primary"
                android:id="@+id/tv_vent_mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="вЂ”"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cx_text_secondary"
                android:id="@+id/tv_vent_mode_footer"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="РћР±РґСѓРІ"/>
        </LinearLayout>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:gravity="center"
            android:id="@+id/btn_vent_prev"
            android:background="@drawable/btn_circle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="вЂ“"/>
        <TextView
            android:background="@color/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text=""/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/chip_recirc_v"
            android:background="@drawable/widget_chip_idle"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_recirc"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/cx_text_primary"
                android:id="@+id/txt_recirc_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Р РµС†РёСЂРєСѓР»СЏС†РёСЏ"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
