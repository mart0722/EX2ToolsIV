<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wg_card_100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/btn_vent_next"
            style="@style/WgRoundButton"
            android:text="+" />

        <LinearLayout
            android:id="@+id/chip_vent_current"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_vent_mode"
                style="@style/WgClimateIcon"
                android:src="@drawable/wg_ic_vent_face" />

            <TextView
                android:id="@+id/tv_vent_mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:text="Лицо"
                android:textColor="@color/wg_text"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_title"
                style="@style/WgSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ОБДУВ" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_vent_prev"
            style="@style/WgRoundButton"
            android:text="−" />

        <LinearLayout
            android:id="@+id/chip_recirc_v"
            style="@style/WgChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_recirc_v"
                style="@style/WgClimateIcon"
                android:src="@drawable/wg_ic_recirc" />

            <TextView
                android:id="@+id/txt_recirc_v"
                style="@style/WgClimateChipLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="0dp"
                android:text="Рецирк." />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
