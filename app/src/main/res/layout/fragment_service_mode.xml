<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="24dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="24dp"
        android:layout_weight="4"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/serviceBadge"
                    style="@style/Text.EX2.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/service_inactive"
                    android:textColor="@color/text_dim" />
            </LinearLayout>

            <TextView
                android:id="@+id/serviceInfo"
                style="@style/Text.EX2.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/service_desc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/serviceAction"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="20dp"
                android:text="@string/service_hide"
                android:textSize="22sp"
                app:cornerRadius="6dp" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/hideSelf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/hide_self"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/hide_self_note" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:background="@color/flyme_fill_b2" />

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/service_group_restore" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/triggerLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/trigger_left_short"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/trigger_hint" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/triggerRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/trigger_right_short"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/trigger_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/testTrigger"
                style="@style/Widget.EX2.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:text="@string/trigger_test"
                android:textSize="19sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showCorners"
                style="@style/Widget.EX2.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:text="@string/show_corners"
                android:textSize="19sp" />

            <TextView
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/show_corners_note" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="6"
        android:orientation="vertical"
        android:paddingStart="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.EX2.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/apps_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectAll"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/select_all"
                android:textSize="15sp"
                app:cornerRadius="6dp" />

            <ImageButton
                android:id="@+id/reloadApps"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reload"
                android:padding="8dp"
                android:src="@drawable/ic_refresh"
                android:tint="@color/cyan" />
        </LinearLayout>

        <TextView
            style="@style/Text.EX2.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/apps_hint" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/appsEmpty"
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/apps_loading"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
