<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="@dimen/content_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/screen_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.ex2tools.iv.ui.FlymeSegmentedGroup
                    android:id="@+id/widgetModeGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/widgetModeStock"
                        style="@style/Widget.EX2.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/widgets_mode_stock" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/widgetModeThird"
                        style="@style/Widget.EX2.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/widgets_mode_third" />
                </com.ex2tools.iv.ui.FlymeSegmentedGroup>

                <TextView
                    android:id="@+id/widgetInfo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_info_circle"
                    android:clickable="true"
                    android:contentDescription="@string/widgets_info_title"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/flyme_label_level1"
                    android:textSize="23sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EX2.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/card_padding"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.EX2.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widgets_climate_icons_title" />

                    <com.ex2tools.iv.ui.FlymeSegmentedGroup
                        android:id="@+id/widgetClimateIconStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/widgetClimateIconStandard"
                            style="@style/Widget.EX2.Toggle"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:textSize="14sp"
                            android:text="@string/widgets_climate_icons_standard" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/widgetClimateIconThin"
                            style="@style/Widget.EX2.Toggle"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:textSize="14sp"
                            android:text="@string/widgets_climate_icons_thin" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/widgetClimateIconExtraThin"
                            style="@style/Widget.EX2.Toggle"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:textSize="14sp"
                            android:text="@string/widgets_climate_icons_extra_thin" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/widgetClimateIconChromeThin"
                            style="@style/Widget.EX2.Toggle"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:textSize="14sp"
                            android:text="@string/widgets_climate_icons_chrome_thin" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/widgetClimateIconChrome"
                            style="@style/Widget.EX2.Toggle"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:textSize="14sp"
                            android:text="@string/widgets_climate_icons_chrome" />
                    </com.ex2tools.iv.ui.FlymeSegmentedGroup>

                    <LinearLayout
                        android:id="@+id/widgetGlassScaleControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/widgetGlassSize"
                            layout="@layout/item_widget_icon_size" />

                        <include
                            android:id="@+id/widgetGlassIconSize"
                            layout="@layout/item_widget_icon_size" />
                    </LinearLayout>

                    <com.ex2tools.iv.ui.FlymeSwitchRow
                        android:id="@+id/widgetClimateIconLabels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widgets_climate_icon_labels"
                        android:textColor="@color/flyme_label_level1"
                        android:textSize="20sp" />

                    <com.ex2tools.iv.ui.FlymeSwitchRow
                        android:id="@+id/widgetShowTitles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widgets_show_titles"
                        android:textColor="@color/flyme_label_level1"
                        android:textSize="20sp" />

                    <com.ex2tools.iv.ui.FlymeSwitchRow
                        android:id="@+id/widgetCardBorder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widgets_card_border"
                        android:textColor="@color/flyme_label_level1"
                        android:textSize="20sp" />

                    <com.ex2tools.iv.ui.FlymeSwitchRow
                        android:id="@+id/widgetButtonBorder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widgets_button_border"
                        android:textColor="@color/flyme_label_level1"
                        android:textSize="20sp" />

                    <com.ex2tools.iv.ui.FlymeSwitchRow
                        android:id="@+id/widgetAccentBoost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/widgets_accent_boost"
                        android:textColor="@color/flyme_label_level1"
                        android:textSize="20sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/widgetOverlayPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.EX2.GroupLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="@string/widgets_overlay_group" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EX2.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            style="@style/Text.EX2.Section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/widgets_overlay_placement" />

                        <com.ex2tools.iv.ui.FlymeSegmentedGroup
                            android:id="@+id/widgetOverlayPlacement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/widgetOverlayPlacementFree"
                                style="@style/Widget.EX2.Toggle"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:text="@string/widgets_overlay_placement_free" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/widgetOverlayPlacementCorners"
                                style="@style/Widget.EX2.Toggle"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:text="@string/widgets_overlay_placement_corners" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/widgetOverlayPlacementGrid"
                                style="@style/Widget.EX2.Toggle"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:text="@string/widgets_overlay_placement_grid" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/widgetOverlayPlacementNeighbor"
                                style="@style/Widget.EX2.Toggle"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:text="@string/widgets_overlay_placement_neighbor" />
                        </com.ex2tools.iv.ui.FlymeSegmentedGroup>

                        <TextView
                            android:id="@+id/widgetOverlayNeighborHint"
                            style="@style/Text.EX2.ListMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/widgets_overlay_neighbor_hint"
                            android:visibility="gone" />

                        <com.ex2tools.iv.ui.FlymeSwitchRow
                            android:id="@+id/widgetOverlayLock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/widgets_overlay_lock"
                            android:textColor="@color/flyme_label_level1"
                            android:textSize="22sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/widgetOverlayList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widgetStandardPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.EX2.GroupLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="@string/widgets_standard_group" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EX2.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            style="@style/Text.EX2.Section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/widgets_opacity" />

                        <SeekBar
                            android:id="@+id/widgetOpacitySeek"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:max="100"
                            android:progress="100"
                            android:progressTint="@color/flyme_blue"
                            android:thumbTint="@color/flyme_blue" />

                        <TextView
                            android:id="@+id/widgetOpacityValue"
                            style="@style/Text.EX2.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/widgetStandardEmpty"
                    style="@style/Text.EX2.ListMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/widgets_standard_empty" />

                <LinearLayout
                    android:id="@+id/widgetStandardList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/widget_settings_clock" />
                <include layout="@layout/widget_settings_speed" />
                <include layout="@layout/widget_settings_vent" />
                <include layout="@layout/widget_settings_range" />
                <include layout="@layout/widget_settings_power" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
