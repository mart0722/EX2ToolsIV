<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wg_card_100" />

    <LinearLayout
        android:id="@+id/widget_glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/wg_glass_inset">

        <LinearLayout
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_heating_title"
                style="@style/WgClimateIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/wg_ic_heat" />

            <TextView
                android:id="@+id/txt_heat_header"
                style="@style/WgSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Обогревы" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chip_wheel_heat"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_wheel_heat"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_wheel_heat_light" />

                <TextView
                    android:id="@+id/txt_wheel_heat"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Руль" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_front_rear_defrost"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_front_rear_defrost"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_rear_heat_light" />

                <TextView
                    android:id="@+id/txt_front_rear_defrost"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Заднее" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_front_max_defrost"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_front_max_defrost"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_heat_windshield" />

                <TextView
                    android:id="@+id/txt_front_max_defrost"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Макс." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/wg_glass_control_gap"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chip_seat_heat_driver"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_seat_heat_driver"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_seat" />

                <TextView
                    android:id="@+id/txt_seat_heat_driver"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wg_heat_seat_driver" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_windshield_heat"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_windshield_heat"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_windshield_heat_light" />

                <TextView
                    android:id="@+id/txt_windshield_heat"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Лобовое" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_seat_heat_passenger"
                style="@style/WgGlassChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_seat_heat_passenger"
                    style="@style/WgClimateIcon"
                    android:src="@drawable/wg_ic_seat" />

                <TextView
                    android:id="@+id/txt_seat_heat_passenger"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wg_heat_seat_passenger" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
