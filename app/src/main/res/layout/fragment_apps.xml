<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="12dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/appsGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/appsGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/appsUsb"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/apps_install_usb"
                    android:src="@drawable/ic_usb"
                    android:tint="@color/flyme_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.EX2.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/apps_install_usb"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.EX2.ListSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/apps_usb_hint" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/appsQr"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/apps_install_qr"
                    android:src="@drawable/ic_qr"
                    android:tint="@color/flyme_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.EX2.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/apps_install_qr"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.EX2.ListSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/apps_qr_hint" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/appSearch"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:hint="@string/apps_search_hint"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/flyme_label_level1"
            android:textColorHint="@color/flyme_label_level3"
            android:textSize="19sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/appFilterGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true"
                android:text="@string/apps_filter_all"
                android:textSize="17sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUser"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/apps_filter_user"
                android:textSize="17sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSystem"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/apps_filter_system"
                android:textSize="17sp" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/appsSummary"
            style="@style/Text.EX2.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="12dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <ProgressBar
                android:id="@+id/appsLoading"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/flyme_blue"
                android:visibility="gone" />

            <TextView
                android:id="@+id/appsEmpty"
                style="@style/Text.EX2.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/apps_loading_short" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/appsGuideline"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/detailEmpty"
                style="@style/Text.EX2.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/apps_select_hint"
                android:textColor="@color/flyme_label_level3" />

            <ScrollView
                android:id="@+id/detailPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/detailIcon"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:contentDescription="@string/app_icon"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/detailName"
                        style="@style/Text.EX2.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/detailType"
                        style="@style/Text.EX2.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/flyme_blue" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <include
                            android:id="@+id/rowPackage"
                            layout="@layout/item_detail_row" />

                        <include
                            android:id="@+id/rowVersion"
                            layout="@layout/item_detail_row" />

                        <include
                            android:id="@+id/rowSignature"
                            layout="@layout/item_detail_row" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detailPermissions"
                        style="@style/Widget.EX2.Toggle"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="24dp"
                        android:text="@string/apps_permissions"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/detailOpen"
                            style="@style/Widget.EX2.PrimaryButton"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:text="@string/apps_open" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/detailUninstall"
                            style="@style/Widget.EX2.DangerButton"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/apps_uninstall" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
