<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overview_card"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        style="@style/Text.EX2.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/climate_scan_title" />

    <TextView
        android:id="@+id/scanHint"
        style="@style/Text.EX2.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/climate_scan_hint" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/scanList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanRefresh"
            style="@style/Widget.EX2.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/climate_find_sensor"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanCancel"
            style="@style/Widget.EX2.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
