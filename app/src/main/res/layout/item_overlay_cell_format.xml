<?xml version="1.0" encoding="utf-8"?>
<com.ex2tools.iv.ui.FlymeSegmentedGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/overlayCellsDefault"
        style="@style/Widget.EX2.Toggle"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/widgets_cells_default"
        android:textSize="15sp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/overlayCellsRow"
        style="@style/Widget.EX2.Toggle"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/widgets_cells_row"
        android:textSize="15sp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/overlayCellsColumn"
        style="@style/Widget.EX2.Toggle"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/widgets_cells_column"
        android:textSize="15sp"
        android:layout_weight="1" />
</com.ex2tools.iv.ui.FlymeSegmentedGroup>
