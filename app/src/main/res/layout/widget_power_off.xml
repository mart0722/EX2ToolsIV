<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_power_off"
    style="@style/WgChip"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/img_power_off"
        style="@style/WgClimateIcon"
        android:src="@drawable/wg_ic_power_off" />

    <TextView
        android:id="@+id/txt_power_off"
        style="@style/WgClimateChipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_name_power_off" />
</LinearLayout>
