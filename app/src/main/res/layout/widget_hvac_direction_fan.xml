<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/widget_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/widget_bg_layer"
        android:background="@drawable/widget_card_bg_100"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text=""/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/chip_vent_face"
                android:background="@drawable/widget_chip_idle"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_climate_vent_face"
                    android:tint="@color/cx_text_primary" />
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/cx_text_primary"
                    android:id="@+id/txt_vent_face"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Лицо"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/chip_vent_floor"
                android:background="@drawable/widget_chip_idle"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_climate_vent_floor"
                    android:tint="@color/cx_text_primary" />
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/cx_text_primary"
                    android:id="@+id/txt_vent_floor"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Ноги"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/chip_vent_face_floor"
                android:background="@drawable/widget_chip_idle"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_climate_vent_face_floor"
                    android:tint="@color/cx_text_primary" />
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/cx_text_primary"
                    android:id="@+id/txt_vent_face_floor"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Лицо+Ноги"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/chip_vent_windshield"
                android:background="@drawable/widget_chip_idle"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_climate_vent_windshield"
                    android:tint="@color/cx_text_primary" />
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/cx_text_primary"
                    android:id="@+id/txt_vent_windshield"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Стекло"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/chip_vent_floor_windshield"
                android:background="@drawable/widget_chip_idle"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_climate_vent_floor_windshield"
                    android:tint="@color/cx_text_primary" />
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/cx_text_primary"
                    android:id="@+id/txt_vent_floor_windshield"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Ноги+Стекло"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/chip_recirc"
                android:background="@drawable/widget_chip_idle"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_climate_recirc"
                    android:tint="@color/cx_text_primary" />
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/cx_text_primary"
                    android:id="@+id/txt_recirc"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Рециркуляция"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:background="@color/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text=""/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/cx_text_primary"
                android:gravity="center"
                android:id="@+id/btn_fan_minus"
                android:background="@drawable/btn_circle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="−"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_climate_fan"
                    android:tint="@color/cx_text_primary" />
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/chip_fan_ac"
                    android:background="@drawable/widget_chip_ac_off"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/cx_text_primary"
                        android:id="@+id/tv_fan_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:id="@+id/dot_fan_1"
                        android:background="@drawable/widget_dot_off"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:text=""
                        android:layout_marginEnd="2dp"/>
                    <TextView
                        android:id="@+id/dot_fan_2"
                        android:background="@drawable/widget_dot_off"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:text=""
                        android:layout_marginEnd="2dp"/>
                    <TextView
                        android:id="@+id/dot_fan_3"
                        android:background="@drawable/widget_dot_off"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:text=""
                        android:layout_marginEnd="2dp"/>
                    <TextView
                        android:id="@+id/dot_fan_4"
                        android:background="@drawable/widget_dot_off"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:text=""
                        android:layout_marginEnd="2dp"/>
                    <TextView
                        android:id="@+id/dot_fan_5"
                        android:background="@drawable/widget_dot_off"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:text=""
                        android:layout_marginEnd="2dp"/>
                    <TextView
                        android:id="@+id/dot_fan_6"
                        android:background="@drawable/widget_dot_off"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:text=""
                        android:layout_marginEnd="2dp"/>
                    <TextView
                        android:id="@+id/dot_fan_7"
                        android:background="@drawable/widget_dot_off"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:text=""/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/cx_text_primary"
                android:gravity="center"
                android:id="@+id/btn_fan_plus"
                android:background="@drawable/btn_circle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="+"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
