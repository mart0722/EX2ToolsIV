<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wg_card_100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wg_ic_vent"
                android:tint="@color/wg_text" />

            <TextView
                style="@style/WgTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Обдув и вентилятор" />

            <TextView
                android:id="@+id/btn_vent_mode"
                style="@style/WgChipLabel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="0dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_wg_chip"
                android:text="@string/widgets_vent_presets" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chip_vent_face"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_vent_face"
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_vent_face"
                    android:tint="@color/wg_text" />

                <TextView
                    android:id="@+id/txt_vent_face"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Лицо" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_vent_floor"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_vent_floor"
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_vent_floor"
                    android:tint="@color/wg_text" />

                <TextView
                    android:id="@+id/txt_vent_floor"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ноги" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_vent_face_floor"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_vent_face_floor"
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_vent_face_floor"
                    android:tint="@color/wg_text" />

                <TextView
                    android:id="@+id/txt_vent_face_floor"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Лицо+ноги" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_vent_windshield"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_vent_windshield"
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_vent_windshield"
                    android:tint="@color/wg_text" />

                <TextView
                    android:id="@+id/txt_vent_windshield"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Стекло" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_vent_floor_windshield"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_vent_floor_windshield"
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_vent_floor_windshield"
                    android:tint="@color/wg_text" />

                <TextView
                    android:id="@+id/txt_vent_floor_windshield"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ноги+стекло" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_recirc"
                style="@style/WgChip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    style="@style/WgIcon"
                    android:src="@drawable/wg_ic_recirc"
                    android:tint="@color/wg_text" />

                <TextView
                    android:id="@+id/txt_recirc"
                    style="@style/WgClimateChipLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Рецирк." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_fan_minus"
                style="@style/WgRoundButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="−" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_fan_value"
                    style="@style/WgValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/dot_fan_1"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_wg_dot_off" />
                    <TextView
                        android:id="@+id/dot_fan_2"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_wg_dot_off" />
                    <TextView
                        android:id="@+id/dot_fan_3"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_wg_dot_off" />
                    <TextView
                        android:id="@+id/dot_fan_4"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_wg_dot_off" />
                    <TextView
                        android:id="@+id/dot_fan_5"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_wg_dot_off" />
                    <TextView
                        android:id="@+id/dot_fan_6"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_wg_dot_off" />
                    <TextView
                        android:id="@+id/dot_fan_7"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_wg_dot_off" />
                </LinearLayout>
            </LinearLayout>



            <TextView
                android:id="@+id/btn_fan_plus"
                style="@style/WgRoundButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
