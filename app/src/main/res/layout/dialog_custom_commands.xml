<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/flyme_modal_background"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        style="@style/Text.EX2.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voice_custom_commands" />

    <TextView
        style="@style/Text.EX2.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voice_custom_commands_note" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/customCommandsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/customAdd"
            style="@style/Widget.EX2.FlymeButton.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/voice_custom_add" />

        <TextView
            android:id="@+id/customClose"
            style="@style/Widget.EX2.FlymeButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/voice_custom_close" />
    </LinearLayout>
</LinearLayout>
