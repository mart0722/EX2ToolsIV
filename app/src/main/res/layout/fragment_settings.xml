<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="@dimen/content_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/screen_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_drive" />

            <TextView
                style="@style/Text.EX2.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/drive_title" />

            <com.ex2tools.iv.ui.FlymeSegmentedGroup
                android:id="@+id/driveGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/driveEco"
                    style="@style/Widget.EX2.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/drive_eco" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/driveComfort"
                    style="@style/Widget.EX2.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/drive_comfort" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/driveSport"
                    style="@style/Widget.EX2.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/drive_sport" />
            </com.ex2tools.iv.ui.FlymeSegmentedGroup>

            <TextView
                style="@style/Text.EX2.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/regen_title" />

            <com.ex2tools.iv.ui.FlymeSegmentedGroup
                android:id="@+id/regenGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/regenWeak"
                    style="@style/Widget.EX2.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/regen_weak" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/regenMedium"
                    style="@style/Widget.EX2.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/regen_medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/regenStrong"
                    style="@style/Widget.EX2.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/regen_strong" />
            </com.ex2tools.iv.ui.FlymeSegmentedGroup>

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/autoApply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/auto_apply"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/auto_apply_note" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/applyNow"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="32dp"
                android:text="@string/apply_now"
                android:textSize="22sp"
                app:cornerRadius="6dp" />

            <TextView
                android:id="@+id/applyResult"
                style="@style/Text.EX2.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/regen_apply_hint" />

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/settings_section_theme" />

            <com.ex2tools.iv.ui.FlymeSegmentedGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeSystem"
                    style="@style/Widget.EX2.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/theme_system" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeLight"
                    style="@style/Widget.EX2.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/theme_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeDark"
                    style="@style/Widget.EX2.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/theme_dark" />
            </com.ex2tools.iv.ui.FlymeSegmentedGroup>

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/settings_section_floating" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/switchScreenshotButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/screenshot_button"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/screenshot_button_note" />

            <com.ex2tools.iv.ui.FlymeSwitchRow
                android:id="@+id/switchTaskButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/task_button_setting"
                android:textColor="@color/flyme_label_level1"
                android:textSize="22sp"
                app:rowDescription="@string/task_button_note" />

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/voice_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsCustomCommands"
                style="@style/Widget.EX2.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="24dp"
                android:text="@string/voice_custom_commands"
                android:textSize="22sp" />

            <TextView
                style="@style/Text.EX2.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/settings_section_misc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsDefaults"
                style="@style/Widget.EX2.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="24dp"
                android:text="@string/settings_restore_defaults"
                android:textSize="22sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
