<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgetSettingsApps"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/appsCount"
        style="@style/Text.EX2.ListMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <com.ex2tools.iv.ui.FlymeSegmentedGroup
        android:id="@+id/appsModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appsModeRow"
            style="@style/Widget.EX2.Toggle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/widgets_apps_mode_row" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appsModeGrid"
            style="@style/Widget.EX2.Toggle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/widgets_apps_mode_grid" />
    </com.ex2tools.iv.ui.FlymeSegmentedGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/appsSelect"
        style="@style/Widget.EX2.SecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="@string/widgets_apps_select" />
</LinearLayout>
