<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wg_card_100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/btn_drive_next"
            style="@style/WgRoundButton"
            android:text="+" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_drive_mode"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wg_ic_drive_comfort"
                android:tint="@color/wg_text" />

            <TextView
                android:id="@+id/tv_drive_mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:text="Комфорт"
                android:textColor="@color/wg_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_drive_mode_footer"
                style="@style/WgSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="РЕЖИМ" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_drive_prev"
            style="@style/WgRoundButton"
            android:text="−" />
    </LinearLayout>
</FrameLayout>
