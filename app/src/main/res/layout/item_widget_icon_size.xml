<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.EX2.ListMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widgets_climate_icon_size" />

        <TextView
            android:id="@+id/widgetIconSizeValue"
            style="@style/Text.EX2.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/widgetIconSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/widgets_climate_icon_size"
        android:progressTint="@color/flyme_blue"
        android:thumbTint="@color/flyme_blue" />
</LinearLayout>
