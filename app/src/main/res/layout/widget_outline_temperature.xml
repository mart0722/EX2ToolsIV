<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wg_card_100" />

    <LinearLayout
        android:id="@+id/widget_glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/wg_glass_inset"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/wg_glass_inset"
        android:paddingBottom="@dimen/wg_glass_compact_inset">

        <LinearLayout
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_temp_title"
                style="@style/WgClimateIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/wg_ic_temp" />

            <TextView
                android:id="@+id/tv_temp_label"
                style="@style/WgSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Температура печки" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_temp_minus"
                style="@style/WgClimateRoundButton"
                android:text="−" />

            <LinearLayout
                android:id="@+id/temp_mid_col"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/temp_icon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_temp_value"
                    style="@style/WgValue"
                    android:textSize="28sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />

                <TextView
                    android:id="@+id/tv_temp_unit"
                    style="@style/WgUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="2dp"
                    android:text="°C" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_temp_plus"
                style="@style/WgClimateRoundButton"
                android:text="+" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/temp_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:max="15"
            android:progress="7"
            android:progressDrawable="@drawable/wg_progress" />
    </LinearLayout>
</FrameLayout>
